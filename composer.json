{
    "name": "wilycode/template-translation",
    "description": "Translation and locale formatting filters for WilyCode Template, with view-aware translation resources.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "wilycode/template": "^0.1",
        "wilycode/translation": "^0.1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "wilycode/router": "^0.1 || ^0.2"
    },
    "autoload": {
        "psr-4": {
            "WilyCode\\Template\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WilyCode\\Template\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/examples",
            "/docs",
            "/benchmark",
            "/benchmarks",
            "/tools",
            "/phpunit.xml",
            "/phpunit.xml.dist",
            "/AGENTS.md",
            "/CHANGELOG.md",
            "/CONTRIBUTING.md",
            "/CODE_OF_CONDUCT.md",
            "/SECURITY.md",
            "/composer.lock",
            "/.github",
            "/.gitignore",
            "/.gitattributes",
            "/.editorconfig",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon",
            "/phpstan.neon.dist",
            "/phpstan.*.neon",
            "/phpstan.*.neon.dist",
            "/pint.json",
            "/rector.php",
            "/psalm.xml",
            "/psalm.xml.dist",
            "/infection.json",
            "/infection.json.dist"
        ]
    },
    "authors": [
        {
            "name": "Simon Piter"
        }
    ],
    "keywords": [
        "wilycode",
        "template",
        "translation",
        "localization",
        "filters",
        "php"
    ],
    "homepage": "https://github.com/wilycode/template-translation",
    "support": {
        "issues": "https://github.com/wilycode/template-translation/issues",
        "source": "https://github.com/wilycode/template-translation"
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist"
    },
    "suggest": {
        "wilycode/router": "Optional route-name fallback for translations outside template rendering."
    }
}
